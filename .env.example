# ─────────────────────────────────────────────────────────────
# Event & Decoration Platform — environment template
# Copy to .env and fill in real values. NEVER commit .env.
# ─────────────────────────────────────────────────────────────

# App
NODE_ENV=development
LOG_LEVEL=info
APP_BASE_URL=http://localhost:3000

# Database (Postgres) — used from Phase 1
DATABASE_URL=postgresql://eventapp:eventapp@localhost:5432/eventapp?schema=public

# Redis (queues / reminders) — used from Phase 10
REDIS_URL=redis://localhost:6379

# Object storage (MinIO / S3-compatible) — used from Phase 5
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=event-uploads
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# Auth — used from Phase 2. Generate a long random string (e.g. `openssl rand -base64 48`).
AUTH_SECRET=change-me-generate-a-long-random-string

# AI (OpenAI / ChatGPT) — used from Phase 6.
# NOTE: production keys are stored per-platform in encrypted settings; this is the dev fallback.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Email (SMTP) — used from Phase 5
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Event Platform <no-reply@example.com>"

# WhatsApp Cloud API (Meta) — optional. The inbound webhook is REJECTED (403)
# unless WHATSAPP_APP_SECRET is set: it verifies Meta's X-Hub-Signature-256.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# WHATSAPP_GRAPH_URL=https://graph.facebook.com/v21.0   # override if needed
